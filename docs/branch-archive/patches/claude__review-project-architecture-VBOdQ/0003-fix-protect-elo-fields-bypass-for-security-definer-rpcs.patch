+
   -- Opdater profilen
   UPDATE public.profiles SET
     elo_rating   = GREATEST(100, ROUND(COALESCE(v_first, 1000) + COALESCE(v_delta, 0))::int),
@@ -45,7 +89,229 @@ BEGIN
 END;
 $$;
 
